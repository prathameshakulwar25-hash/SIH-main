# Security & Authentication
ENV_MODE=development
JWT_SECRET=production_super_secret_jwt_key_change_me_in_prod
JWT_EXPIRY_MINUTES=480
PHYSICIAN_PIN=1234
FRONTEND_URL=http://localhost:5173

# Live HL7 FHIR R4 Integration
# Production / Sandbox endpoint for FHIR Bundle transmission
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# ABDM Gateway Configuration (National Digital Health Mission)
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# LLM API Configuration (Groq & xAI Grok compatible)
GROQ_API_KEY=
GROK_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROK_MODEL=grok-2-latest
GROQ_API_BASE=https://api.groq.com/openai/v1
XAI_API_BASE=https://api.x.ai/v1

# SendGrid Email Configuration
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=reports@jeevanopd.in

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEMPLATE_NAME=

# Optional Providers (AWS SES, SMTP, MSG91)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JEEVAN
MSG91_OTP_TEMPLATE_ID=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=

# Firebase Admin SDK & Cloud Messaging (Phone Auth + Web Push)
# --- For Render/Cloud deployments (recommended) ---
# Open firebase-service-account.json, copy the entire JSON text, and paste it as the value below:
FIREBASE_SERVICE_ACCOUNT_JSON=
# --- For local development (alternative) ---
# Place your service account JSON file as backend/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=

# Production Database (PostgreSQL - Supabase / Neon / AWS RDS)
# If left commented or blank, the backend automatically defaults to local SQLite (data/ayush.db)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Example Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=
