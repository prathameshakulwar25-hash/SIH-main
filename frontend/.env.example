# Backend API base URL
# In local development: http://localhost:8000
# In Netlify production: https://sih-main-b6mx.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# ── Firebase Client Configuration ──
# (Found in Firebase Console > Project Settings > General > Your Apps > Web App </>)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Cloud Messaging (FCM) Web Push Certificate ──
# (Found in Firebase Console > Project Settings > Cloud Messaging > Web Configuration > Web Push certificates > Key pair)
VITE_FIREBASE_VAPID_KEY=
